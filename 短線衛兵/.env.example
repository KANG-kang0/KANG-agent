# 必填：從 @BotFather 取得
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 必填：Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 選填：FinMind 帳號 token（免費註冊可提升速率限制至 600 req/hr）
# 申請：https://finmindtrade.com/
FINMIND_TOKEN=

# 選填：使用者白名單（逗號分隔的 Telegram user id）。
# 留空 = 開放所有人；填了 = 只有名單內的人能用，其他人會收到自己的 ID。
ALLOWED_USER_IDS=
