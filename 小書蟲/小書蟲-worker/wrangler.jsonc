{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaoshuchong-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 7 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATE",
      "id": "f11490f525134531889ec455e774385b"
    }
  ]
}
